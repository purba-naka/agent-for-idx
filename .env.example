# Salin ke .env lalu isi nilainya. JANGAN commit .env.

# --- Polling Keterbukaan Informasi IDX ---
IDX_POLL_SECONDS=180
IDX_LOOKBACK_MINUTES=10
# Kosong = semua emiten. Contoh: BBCA,TLKM,ANTM
IDX_ISSUERS=
# Kosong = semua topik. Contoh: dividen,buyback,akuisisi,right issue
IDX_KEYWORDS=
# * = semua, s = saham, o = obligasi
IDX_EMITEN_TYPE=*
# Hanya diisi bila curl_cffi gagal menembus Cloudflare
IDX_COOKIE=

# --- Model LLM (kompatibel OpenAI: 9router, LiteLLM, OpenAI, dll) ---
LLM_BASE_URL=http://localhost:20128/v1
OPENAI_API_KEY=
OPENAI_MODEL=

# --- Telegram ---
# Token dari @BotFather
TELEGRAM_BOT_TOKEN=
# Kirim /start ke bot Anda, lalu buka:
#   https://api.telegram.org/bot<TOKEN>/getUpdates
# Ambil result[0].message.chat.id (BUKAN update_id)
TELEGRAM_CHAT_ID=

# --- Kurasi oleh LLM (node triage) ---
# Profil minat Anda; dipakai LLM untuk menilai materialitas tiap pengumuman.
# Kosongkan untuk memakai profil bawaan di app/config.py.
AGENT_PROFILE=
# Skor 1-5. Di bawah ambang ini tidak diringkas dan tidak dikirim.
# 3 = longgar, 4 = ketat.
AGENT_MIN_IMPORTANCE=3
# false = lewati triage, kembali ke filter kata kunci saja (hemat 1 panggilan LLM)
AGENT_LLM_TRIAGE=true

# --- Secret endpoint inbound (/trigger, /stats, /webhook/idx, /ws/idx) ---
# Buat dengan: python -c "import secrets; print(secrets.token_urlsafe(32))"
IDX_WEBHOOK_SECRET=

# --- Webhook keluar (opsional; kosongkan bila hanya pakai Telegram) ---
WEBHOOK_URL=
WEBHOOK_FORMAT=generic
WEBHOOK_SECRET=
WEBHOOK_RESPECT_FILTER=true

# --- Lain-lain ---
DATABASE_PATH=idx_agent.sqlite3
HOST=127.0.0.1
PORT=8000
